{
  "name": "rmc-colyseus-multiplayer-server",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "main": "server.ts",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "probe": "node scripts/probe.mjs",
    "test": "node --import tsx --test --test-concurrency=1 multiplayer-server/test/*.mjs"
  },
  "dependencies": {
    "@colyseus/core": "0.17.44",
    "@colyseus/schema": "4.0.26",
    "@colyseus/ws-transport": "0.17.13",
    "express": "4.22.3"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.17.43",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
